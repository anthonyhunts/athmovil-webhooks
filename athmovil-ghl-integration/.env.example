# ===========================================
# GO HIGH LEVEL - Credenciales de tu App
# ===========================================
# Estas las obtienes al crear tu app en el Marketplace de GHL
GHL_APP_CLIENT_ID=tu_client_id_aqui
GHL_APP_CLIENT_SECRET=tu_client_secret_aqui

# ===========================================
# ATH MOVIL - Credenciales de tu Business
# ===========================================
# Estas las encuentras en ATH Movil Business App > Settings
ATHMOVIL_PUBLIC_TOKEN=tu_public_token_aqui
ATHMOVIL_PRIVATE_TOKEN=tu_private_token_aqui

# ===========================================
# CONFIGURACION DEL SERVIDOR
# ===========================================
PORT=3000
NODE_ENV=development

# URL base de tu servidor (cambiar en produccion)
# Ejemplo produccion: https://tu-dominio.com
BASE_URL=http://localhost:3000

# Secret para sesiones (genera uno aleatorio para produccion)
SESSION_SECRET=cambia_esto_por_un_string_aleatorio_largo

# ===========================================
# ATHMOVIL API URLs
# ===========================================
ATHMOVIL_API_URL=https://payments.athmovil.com/api
ATHMOVIL_WEBHOOK_URL=https://www.athmovil.com/transactions/webhook/post

# ===========================================
# GO HIGH LEVEL API URLs
# ===========================================
GHL_API_URL=https://services.leadconnectorhq.com
GHL_AUTH_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
